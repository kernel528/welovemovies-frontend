{
  "name": "welovemovies-frontend",
  "version": "2.0.0",
  "private": true,
  "dependencies": {
    "@testing-library/jest-dom": "^5.11.5",
    "@testing-library/react": "^11.1.1",
    "@testing-library/user-event": "^12.2.0",
    "react": "^17.0.1",
    "react-dom": "^17.0.1",
    "react-router": "^5.2.0",
    "react-router-dom": "^5.2.0",
    "util": "^0.12.5",
    "web-vitals": "^0.2.4"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "test": "vitest",
    "test:ci": "vitest run",
    "docker:build": "docker build --target runtime --build-arg VITE_API_BASE_URL=http://localhost:5001 --tag kernel528/welovemovies-frontend:local .",
    "docker:run": "docker run --rm --name welovemovies-frontend --publish 8080:80 kernel528/welovemovies-frontend:local",
    "docker:stop": "docker rm --force welovemovies-frontend",
    "docker:smoke": "npm run docker:build && node scripts/smoke-local-image.js"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^26.1.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
