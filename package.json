{
  "name": "welovemovies-frontend",
  "version": "1.2.0",
  "private": true,
  "dependencies": {
    "@testing-library/jest-dom": "^5.11.5",
    "@testing-library/react": "^11.1.1",
    "@testing-library/user-event": "^12.2.0",
    "markdown": "^0.5.0",
    "react": "^17.0.1",
    "react-dom": "^17.0.1",
    "react-router": "^5.2.0",
    "react-router-dom": "^5.2.0",
    "react-scripts": "^5.0.1",
    "util": "^0.12.5",
    "web-vitals": "^0.2.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "start-legacy": "NODE_OPTIONS=--openssl-legacy-provider react-scripts start",
    "build": "react-scripts build",
    "build-legacy": "NODE_OPTIONS=--openssl-legacy-provider react-scripts build",
    "test": "react-scripts test",
    "test:ci": "CI=true react-scripts test --watchAll=false",
    "docker:build": "docker build --target runtime --build-arg REACT_APP_API_BASE_URL=http://localhost:5001 --tag kernel528/welovemovies-frontend:local .",
    "docker:run": "docker run --rm --name welovemovies-frontend --publish 8080:80 kernel528/welovemovies-frontend:local",
    "docker:stop": "docker rm --force welovemovies-frontend",
    "docker:smoke": "npm run docker:build && node scripts/smoke-local-image.js",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "overrides": {
    "underscore": "^1.13.8",
    "nth-check": "^2.1.1",
    "postcss": "^8.5.16",
    "serialize-javascript": "^6.0.2",
    "uuid": "^11.1.1",
    "follow-redirects": "^1.15.12"
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11"
  }
}
